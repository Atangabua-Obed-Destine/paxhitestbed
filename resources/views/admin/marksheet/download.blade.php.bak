       .template-inner {
         position: relative;
         z-index: 1;
         background-color: transparent !important;
         width: 100% !important;
       }
       
       /* Make all tables transparent */
       table {
         background-color: transparent !important;
       }
       
       table td,
       table th {
         background-color: transparent !important;
       }
       
       /* Add borders to marksheet table */
       table.marksheet {
         border-collapse: collapse !important;
         width: 100%;
         table-layout: fixed;
         background-color: transparent !important;
       }
       table.marksheet th,
       table.marksheet td {
         border: 1px solid #000 !important;
         padding: 8px !important;
         word-wrap: break-word;
         background-color: transparent !important;
       }
       table.marksheet th {
         font-weight: bold;
       }
       table.marksheet tbody tr td {
         border: 1px solid #000 !important;
         background-color: transparent !important;
       }
       table.marksheet thead tr th {
         border: 1px solid #000 !important;
         background-color: transparent !important;
       }
       /* Column widths */
       table.marksheet th:nth-child(1),
       table.marksheet td:nth-child(1) {
         width: 10%;
       }
       table.marksheet th:nth-child(2),
       table.marksheet td:nth-child(2) {
         width: 25%;
       }
       table.marksheet th:nth-child(3),
       table.marksheet td:nth-child(3) {

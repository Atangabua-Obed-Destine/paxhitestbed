        var options = {
          margin:       [0.5, 0.5, 0.5, 0.5],
          filename:     pdf_title,
          image:        { type: 'jpeg', quality: 8.00 },
          html2canvas:  { scale: 2 },
          jsPDF:        { unit: 'in', format: 'A4', orientation: 'portrait' }
        };

        html2pdf(pdf_content, options);
    </script>

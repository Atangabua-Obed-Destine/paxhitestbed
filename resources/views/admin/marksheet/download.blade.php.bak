    @php
        $total_credits = 0;
        $total_cgpa = 0;
        $starting_year = '';
        $ending_year = '';
        
        // Use selectedProgramId from controller (based on enrollment_id parameter)
        // If not set, fallback to student's base program_id
        if (!isset($selectedProgramId)) {
            $selectedProgramId = $row->program_id;
        }
    @endphp


    {{-- CGPA and Credit Cal --}}
    @foreach( $row->studentEnrolls as $key => $item )
        @if($item->program_id == $selectedProgramId)

        {{-- Year Selection --}}
        @if($loop->first)
        @php
            $starting_year = $item->session->title;
        @endphp
        @endif

        @if($loop->last)
        @php
            $ending_year = $item->session->title;
        @endphp
        @endif

        @if(isset($item->subjectMarks))
        @foreach($item->subjectMarks as $mark)

            @php
            $marks_per = round($mark->total_marks);
            @endphp

            @foreach($grades as $grade)
            @if($marks_per >= $grade->min_mark && $marks_per <= $grade->max_mark)
            @php
            // Always count all courses towards CGPA calculation, including F grades
            $total_cgpa = $total_cgpa + ($grade->point * $mark->subject->credit_hour);
            $total_credits = $total_credits + $mark->subject->credit_hour;
            @endphp
            @break
            @endif
            @endforeach

        @endforeach
        @endif
        @endif

    @endforeach


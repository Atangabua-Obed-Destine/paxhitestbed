                                    <!-- Total Cost (hidden but submitted) -->
                                    <input type="hidden" name="total_cost" id="total_cost" value="{{ round($total_cost, 0) }}" data_id="add-{{ $row->id }}">
                                    
                                    @if($employer_tax_amount > 0)
                                    <div class="form-group">
                                        <label for="total_cost_display">{{ __('field_total_cost') }} ({!! $setting->currency_symbol !!})</label>
                                        <input type="text" class="form-control bg-info text-white" id="total_cost_display" value="{{ round($total_cost, 0) }}" readonly data_id="add-{{ $row->id }}">

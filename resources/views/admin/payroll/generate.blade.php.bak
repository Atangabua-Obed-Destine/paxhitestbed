                                                        {{ __('employer') }}: {{ number_format((float)$tax->employer_fixed_amount, 2, '.', '') }} {!! $setting->currency_symbol !!}
                                                    @else
                                                        {{ __('employee') }}: {{ number_format($tax->percentange, 2) }}% |
                                                        {{ __('employer') }}: {{ number_format($tax->employer_percentage, 2) }}%
                                                    @endif
                                                @elseif($paid_by == 'employer')
                                                    <span class="badge badge-primary"><i class="fas fa-building"></i> {{ __('employer_only') }}</span>
                                                @else
                                                    @if($tax->tax_type == 2)
                                                    {{ number_format((float)$tax->fixed_amount, 2, '.', '') }} {!! $setting->currency_symbol !!} ({{ __('tax_type_fixed') }})
                                                    @else
                                                    {{ number_format($tax->percentange, 2) }}% ({{ __('tax_type_percentage') }})
                                                    @endif
                                                @endif
                                                @endif
                                                ({{ __('field_range') }}: 
                                                @if(isset($setting->decimal_place))
                                                {{ number_format((float)$tax->min_amount, $setting->decimal_place, '.', '') }} - {{ number_format((float)$tax->max_amount, $setting->decimal_place, '.', '') }}
                                                @else
                                                {{ number_format((float)$tax->min_amount, 2, '.', '') }} - {{ number_format((float)$tax->max_amount, 2, '.', '') }}
                                                @endif
                                                {!! $setting->currency_symbol !!})
                                            </small>
                                            @endif
                                        @endforeach
                                        @endif

                                        {{-- Display Dependent Tax Brackets --}}
                                        @if(isset($dependent_taxs) && $dependent_taxs->count() > 0)
                                        @foreach($dependent_taxs as $dep_tax)
                                            @if($dep_tax->min_amount <= $total_earning && $dep_tax->max_amount >= $total_earning)
                                            @php
                                            $dep_is_exempt = $row->exemptTaxes->contains('id', $dep_tax->id);
                                            $dep_result = $standalone_tax_results[$dep_tax->id] ?? null;
                                            $dep_source_amount = $dep_result['source_amount'] ?? 0;
                                            $dep_employee_tax = $dep_result['employee'] ?? 0;
                                            $dep_employer_tax = $dep_result['employer'] ?? 0;
                                            $dep_source_label = $dep_tax->dependency_label ?? __('unknown');
                                            @endphp
                                            <small class="form-text text-muted">
                                                <i class="fas fa-link text-warning"></i> <strong>{{ $dep_tax->title ?? 'Tax' }}</strong>
                                                <span class="badge badge-warning">{{ __('dependent') }}</span>
                                                @if($dep_is_exempt)
                                                    <span class="badge badge-success">{{ __('fully_exempt') }}</span>
                                                @else
                                                    @if($dep_tax->tax_type == 1)
                                                    {{ number_format($dep_tax->percentange, 2) }}%
                                                    @else
                                                    {{ number_format($dep_tax->fixed_amount, 2) }} {!! $setting->currency_symbol !!}
                                                    @endif
                                                    {{ __('of') }} {{ $dep_source_label }}
                                                    = {{ number_format($dep_employee_tax + $dep_employer_tax, 2) }} {!! $setting->currency_symbol !!}
                                                @endif
                                                <br>
                                                <span class="text-muted pl-3"><i class="fas fa-caret-right"></i> {{ __('source_tax_output') }}: {{ number_format($dep_source_amount, 2) }} {!! $setting->currency_symbol !!}</span>
                                            </small>
                                            @endif
                                        @endforeach
                                        @endif

                                        <div class="invalid-feedback">
                                          {{ __('required_field') }} {{ __('field_tax') }}
                                        </div>

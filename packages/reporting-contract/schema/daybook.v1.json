{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://edutrustpay.example/schema/daybook.v1.json",
    "title": "EdutrustPay monthly daybook",
    "description": "One month of a school's daybook: every movement of money, one line each. This document contains names of people.",
    "type": "object",
    "additionalProperties": false,
    "required": ["document", "version", "institution_ref", "period", "sequence", "generated_at", "currency", "money_in", "money_out", "lines"],
    "definitions": {
        "money": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" }
    },
    "properties": {
        "document": { "const": "daybook" },
        "version": { "const": 1 },
        "institution_ref": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "money_in": { "$ref": "#/definitions/money" },
        "money_out": { "$ref": "#/definitions/money" },
        "lines": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["date", "ref", "description", "party", "heading", "kind", "direction", "amount", "method", "source_id"],
                "properties": {
                    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                    "ref": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "party": { "type": ["string", "null"] },
                    "heading": { "type": "string", "minLength": 1 },
                    "kind": { "enum": ["fee", "income", "expense", "payroll", "refund", "remittance", "other"] },
                    "direction": { "enum": ["in", "out"] },
                    "amount": { "$ref": "#/definitions/money" },
                    "method": { "enum": ["cash", "bank", "cheque", "card", "mobile_money", "online", "other", null] },
                    "source_id": { "type": "string", "minLength": 1 }
                }
            }
        }
    }
}

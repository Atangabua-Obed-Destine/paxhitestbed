{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://edutrustpay.local/schema/report.v1.0.json",
    "title": "EdutrustPay Reporting Contract v1.0",
    "description": "A single institution's figures for a single CALENDAR MONTH. The unit is always the calendar month, never a fiscal year: paxhitestbed runs January-December while the schools run July-June, so a body holds both and the console assembles any fiscal year from months. A capability absent from \"capabilities\" means CANNOT REPORT; a figure present with value 0 means GENUINELY ZERO. These are different facts and must never be conflated.",
    "type": "object",
    "required": [
        "contract_version",
        "institution_ref",
        "period",
        "status",
        "sequence",
        "generated_at",
        "currency",
        "capabilities"
    ],
    "additionalProperties": false,
    "properties": {
        "contract_version": {
            "type": "string",
            "enum": [
                "1.0"
            ]
        },
        "institution_ref": {
            "type": "string",
            "minLength": 1
        },
        "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "description": "Calendar month, \"YYYY-MM\". Never a fiscal year."
        },
        "status": {
            "type": "string",
            "enum": [
                "provisional",
                "final"
            ],
            "description": "A month may be reported while still open (provisional) and again when closed (final). Restating a FINAL period is a control event."
        },
        "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Increments per (institution, period). A higher sequence supersedes; the prior version is retained, never overwritten."
        },
        "generated_at": {
            "type": "string",
            "format": "date-time"
        },
        "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
        },
        "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                    "ledger",
                    "receivables",
                    "payables",
                    "budget",
                    "enrolment",
                    "payroll",
                    "integrity",
                    "bank_recon"
                ]
            },
            "description": "What this institution can report. Omission means cannot report. An institution with nothing new to say sends a heartbeat, not an empty report."
        },
        "financial": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "income_by_group": {
                    "type": "object",
                    "description": "Keyed by two-digit OHADA group. Consolidation happens at OHADA class/group level so no institution has to adopt anyone else's chart of accounts. An empty month is {} — never [].",
                    "propertyNames": {
                        "pattern": "^[0-9]{2}$"
                    },
                    "patternProperties": {
                        "^[0-9]{2}$": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        }
                    },
                    "additionalProperties": false
                },
                "expenditure_by_group": {
                    "type": "object",
                    "description": "Keyed by two-digit OHADA group. Consolidation happens at OHADA class/group level so no institution has to adopt anyone else's chart of accounts. An empty month is {} — never [].",
                    "propertyNames": {
                        "pattern": "^[0-9]{2}$"
                    },
                    "patternProperties": {
                        "^[0-9]{2}$": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        }
                    },
                    "additionalProperties": false
                },
                "surplus_deficit": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                },
                "cash": {
                    "type": "object",
                    "required": [
                        "opening",
                        "movement",
                        "closing"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "opening": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "movement": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "closing": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        }
                    }
                },
                "control": {
                    "type": "object",
                    "description": "Control totals, so the console can verify the ledger balances itself rather than trusting a summary. An unbalanced set is ACCEPTED and raises a finding — it is never rejected at ingest.",
                    "required": [
                        "total_debits",
                        "total_credits",
                        "journal_entry_count",
                        "unposted_count"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "total_debits": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "total_credits": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "journal_entry_count": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "unposted_count": {
                            "type": "integer",
                            "minimum": 0
                        }
                    }
                },
                "receivables": {
                    "type": "object",
                    "required": [
                        "total",
                        "ageing"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "total": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "ageing": {
                            "type": "object",
                            "required": [
                                "0_30",
                                "31_60",
                                "61_90",
                                "90_plus"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "0_30": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "31_60": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "61_90": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "90_plus": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                }
                            }
                        }
                    }
                },
                "payables": {
                    "type": "object",
                    "required": [
                        "total",
                        "ageing"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "total": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "ageing": {
                            "type": "object",
                            "required": [
                                "0_30",
                                "31_60",
                                "61_90",
                                "90_plus"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "0_30": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "31_60": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "61_90": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                },
                                "90_plus": {
                                    "type": "string",
                                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                                }
                            }
                        }
                    }
                },
                "budget": {
                    "type": "object",
                    "required": [
                        "budgeted",
                        "actual"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "budgeted": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "actual": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        }
                    }
                },
                "payroll": {
                    "type": "object",
                    "required": [
                        "staff_cost",
                        "statutory_liabilities"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "staff_cost": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "statutory_liabilities": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        }
                    }
                },
                "bank_recon": {
                    "type": "object",
                    "description": "Reconciliation against a source the bursar does not author — the highest-value control in the platform.",
                    "required": [
                        "statement_closing",
                        "ledger_closing",
                        "divergence",
                        "statement_ref"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "statement_closing": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "ledger_closing": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "divergence": {
                            "type": "string",
                            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                            "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                        },
                        "statement_ref": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "operational": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enrolment": {
                    "type": "integer",
                    "minimum": 0
                },
                "expected_fees": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                    "description": "Enrolment multiplied by the fee structure the BODY set — not a figure the institution chose. Compared against collected, it turns \"do we trust this report\" into arithmetic."
                },
                "collected": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$",
                    "description": "A decimal string such as \"4200000.00\". NEVER a JSON number: float encoding is not reproducible across PHP versions and would break the payload signature."
                },
                "collection_rate": {
                    "type": "string",
                    "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$",
                    "description": "A decimal string between \"0\" and \"1\", e.g. \"0.50\". Never a float."
                },
                "cash_share": {
                    "type": "string",
                    "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$",
                    "description": "Proportion taken as physical cash. The exposure measure for interception."
                }
            }
        },
        "integrity": {
            "type": "object",
            "required": [
                "ledger_hash",
                "audit_events",
                "reversals",
                "backdated_entries"
            ],
            "additionalProperties": false,
            "properties": {
                "ledger_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "description": "Hash over the period's journal lines, so the console can tell that a period's underlying detail changed even when its totals did not."
                },
                "audit_events": {
                    "type": "integer",
                    "minimum": 0
                },
                "reversals": {
                    "type": "integer",
                    "minimum": 0
                },
                "backdated_entries": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Entries whose entry date precedes the date they were created, EXCLUDING reversals. Reversals are legitimately dated to the original entry when its period is still open, so counting them here would make the finding fire constantly on correct behaviour."
                }
            }
        }
    },
    "allOf": [
        {
            "title": "Capability \"ledger\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "ledger"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "income_by_group",
                            "expenditure_by_group",
                            "surplus_deficit",
                            "cash",
                            "control"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "income_by_group": false,
                            "expenditure_by_group": false,
                            "surplus_deficit": false,
                            "cash": false,
                            "control": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"receivables\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "receivables"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "receivables"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "receivables": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"payables\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "payables"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "payables"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "payables": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"budget\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "budget"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "budget"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "budget": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"payroll\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "payroll"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "payroll"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "payroll": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"bank_recon\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "bank_recon"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "financial": {
                        "required": [
                            "bank_recon"
                        ]
                    }
                },
                "required": [
                    "financial"
                ]
            },
            "else": {
                "properties": {
                    "financial": {
                        "properties": {
                            "bank_recon": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"enrolment\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "enrolment"
                        }
                    }
                }
            },
            "then": {
                "properties": {
                    "operational": {
                        "required": [
                            "enrolment"
                        ]
                    }
                },
                "required": [
                    "operational"
                ]
            },
            "else": {
                "properties": {
                    "operational": {
                        "properties": {
                            "enrolment": false
                        }
                    }
                }
            }
        },
        {
            "title": "Capability \"integrity\" is declared if and only if its figures are present.",
            "if": {
                "properties": {
                    "capabilities": {
                        "contains": {
                            "const": "integrity"
                        }
                    }
                }
            },
            "then": {
                "required": [
                    "integrity"
                ]
            },
            "else": {
                "properties": {
                    "integrity": false
                }
            }
        }
    ]
}

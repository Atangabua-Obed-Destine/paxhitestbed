{
    "name": "edutrustpay/reporting-contract",
    "description": "The EdutrustPay Reporting Contract - the shared, versioned agreement by which institutions push signed monthly figures to a body.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EdutrustPay\\Contract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdutrustPay\\Contract\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

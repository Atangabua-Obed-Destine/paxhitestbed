/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Cache files that contain local paths - MUST NOT be deployed!
/bootstrap/cache/*.php
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Laravel Excel writes temporary workbooks here while building a download.
# The rule lives in this file rather than in a .gitignore inside the folder:
# on the server that folder belongs to the web server's user, so `git pull`
# cannot create a file in it.
/storage/framework/laravel-excel/

# Production fix files (delete after use)
production-quick-fix.php
production-quick-fix.sh
test-db.php

# Ignore user uploads
/public/uploads
